<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      xUnit1051 wants TestContext.Current.CancellationToken threaded through every awaited call.
      These tests only touch temp-directory files and finish in milliseconds, so the ceremony buys
      nothing; warnings-as-errors would otherwise make it fatal.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NightShift.Core\NightShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Real-world ccusage payloads (plan.md §4.2). They are loaded from disk rather than embedded as
    string literals so the exact bytes a real `ccusage` JSON run emits can be pasted in verbatim.
  -->
  <ItemGroup>
    <Content Include="Fixtures\**\*.json;Fixtures\**\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Plan fixtures for the markdown reader. On disk rather than in string literals for the same
    reason as the payloads above, plus one specific to these: the agreement tests care about exact
    bytes — CRLF, a BOM, a missing trailing newline — and a C# literal cannot carry those.
  -->
  <ItemGroup>
    <Content Include="Fixtures\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
