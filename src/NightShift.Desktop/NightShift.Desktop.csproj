<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Compiled bindings everywhere. A reflection binding that names a property the view model does
      not have fails at run time and prints a line nobody reads; the same typo under compiled
      bindings is a build error, which is the only way a UI this large stays honest.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Release publish only. Without these, `dotnet publish` emits 133 MB, of which ~120 MB is
    dependency symbol files nobody downloading a release wants — libSkiaSharp.pdb alone is 84 MB.
    Native libraries are bundled into the single file too, otherwise "single file" still ships three
    loose DLLs beside the exe.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightShift.Core\NightShift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reason as NightShift.Core: tests reach implementation details that are not worth
         widening a view model's surface for. -->
    <InternalsVisibleTo Include="NightShift.Desktop.Tests" />
  </ItemGroup>

  <!--
    The native SkiaSharp/HarfBuzz packages ship their own .pdb files, which the managed symbol
    switches above do not reach: 105 MB of symbols for libraries we do not debug, in a download
    whose actual payload is 33 MB.
  -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
