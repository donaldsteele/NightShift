<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NightShift.Desktop.Platform.ConfirmationDialog"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm">

  <Border Padding="24">
    <StackPanel Spacing="18">

      <TextBlock x:Name="HeadingText"
                 FontSize="17"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />

      <TextBlock x:Name="MessageText"
                 TextWrapping="Wrap"
                 LineHeight="20"
                 Foreground="{DynamicResource NsSubtleBrush}" />

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <!--
          Cancel is the focused, default button on purpose. The dialog exists because the action
          behind it can burn a weekly quota (plan.md §6.1); a stray Enter must not be able to
          trigger it.
        -->
        <Button x:Name="CancelButton"
                Content="Cancel"
                IsCancel="True"
                IsDefault="True"
                MinWidth="96" />

        <Button x:Name="ConfirmButton"
                Classes="danger"
                MinWidth="96" />
      </StackPanel>

    </StackPanel>
  </Border>

</Window>
